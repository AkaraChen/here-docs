{
  "name": "here-docs",
  "version": "0.1.0",
  "description": "Local any-file-to-Markdown conversion for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "here-docs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaraChen/here-docs.git"
  },
  "bugs": {
    "url": "https://github.com/AkaraChen/here-docs/issues"
  },
  "homepage": "https://github.com/AkaraChen/here-docs#readme",
  "license": "MIT",
  "author": "akarachen",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke-convert.js",
    "prepare": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "postinstall": "node scripts/check-natives.js"
  },
  "dependencies": {
    "@arcships/light-ocr": "0.5.9",
    "@firecrawl/anydoc": "0.1.9",
    "@firecrawl/pdf-inspector": "1.14.2",
    "@kenjiuno/decompressrtf": "0.1.4",
    "@kenjiuno/msgreader": "1.29.0",
    "chardet": "2.2.0",
    "domhandler": "6.0.1",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "iconv-lite": "0.7.3",
    "libheif-js": "1.23.5",
    "postal-mime": "4.2.0",
    "rtf-stream-parser": "4.0.0",
    "sharp": "0.35.3"
  },
  "optionalDependencies": {
