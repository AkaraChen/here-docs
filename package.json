{
  "name": "here-docs",
  "version": "0.1.0",
  "description": "Local any-file-to-Markdown conversion for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "here-docs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaraChen/here-docs.git"
  },
  "bugs": {
    "url": "https://github.com/AkaraChen/here-docs/issues"
  },
  "homepage": "https://github.com/AkaraChen/here-docs#readme",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "prepare": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\""
  },
  "dependencies": {
    "@arcships/light-ocr": "^0.5.7",
    "@firecrawl/anydoc": "^0.1.9",
    "@firecrawl/pdf-inspector": "^1.14.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "publint": "^0.3.23",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
